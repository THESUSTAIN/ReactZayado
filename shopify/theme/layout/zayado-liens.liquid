<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#FDFCF8">
    <title>{{ page_title }} — Zayado</title>
    <meta name="description" content="{{ page_description | default: 'Entreprendre avec sens, clarté financière et équilibre.' | escape }}">
    {%- if settings.favicon != blank -%}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
    {{ content_for_header }}
  </head>
  <body style="margin:0; background:#FDFCF8;">
    {{ content_for_layout }}
  </body>
</html>
