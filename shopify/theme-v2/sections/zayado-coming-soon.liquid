{%- comment -%} Page « Bientôt » de la boutique (d'après la maquette Canva) : hero nuit, 3 atouts, liste d'attente + guide offert. {%- endcomment -%}
<div class="zy-cs" data-testid="coming-soon">
  <section class="zy-cs__hero">
    <div class="zy-cs__in">
      <p class="zy-cs__pastille zy-anim">{{ section.settings.surtitre }}</p>
      <h1 class="zy-cs__titre zy-anim" style="--d:.1s">{{ section.settings.titre }} <span>{{ section.settings.titre_beige }}</span></h1>
      <p class="zy-cs__citation zy-anim" style="--d:.2s">{{ section.settings.citation }}</p>
      <p class="zy-cs__texte zy-anim" style="--d:.3s">{{ section.settings.texte }}</p>
      <div class="zy-cs__actions zy-anim" style="--d:.4s">
        <a class="zy-cs__btn zy-cs__btn--beige" href="#liste-attente" data-testid="coming-soon-cta">Rejoindre la liste d'attente</a>
        <a class="zy-cs__btn zy-cs__btn--ligne" href="{{ section.settings.lien_diag }}" data-testid="coming-soon-diagnostic">Faire le diagnostic en 2 minutes</a>
      </div>
    </div>
  </section>

  <section class="zy-cs__atouts">
    <div class="zy-cs__in zy-cs__grille">
      {%- for i in (1..3) -%}
        {%- capture t %}atout_{{ i }}_titre{% endcapture -%}{%- capture x %}atout_{{ i }}_texte{% endcapture -%}{%- capture ic %}atout_{{ i }}_icone{% endcapture -%}
        <div class="zy-cs__atout zy-anim" style="--d: {{ i | times: 0.1 }}s" data-testid="coming-soon-atout-{{ i }}">
          <span class="zy-cs__icone">{%- render 'zayado-icone', nom: section.settings[ic] -%}</span>
          <p class="zy-cs__atout-titre">{{ section.settings[t] }}</p>
          <p class="zy-cs__atout-texte">{{ section.settings[x] }}</p>
        </div>
      {%- endfor -%}
    </div>
    <p class="zy-cs__lancement"><span></span>{{ section.settings.lancement }}</p>
  </section>

  <section class="zy-cs__news" id="liste-attente">
    <div class="zy-cs__carte">
      <div>
        <p class="zy-cs__sur">Restez informé·e</p>
        <h2 class="zy-cs__h2">{{ section.settings.news_titre }}</h2>
        <p class="zy-cs__news-texte">{{ section.settings.news_texte }}</p>
      </div>
      {%- render 'zayado-aimant', aimant: 'lumiere', source: 'coming-soon', variante: 'carte', choix: true -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Zayado — Bientôt",
  "class": "zy",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Pastille", "default": "Marketplace outils & services" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Le bon outil, au bon moment," },
    { "type": "text", "id": "titre_beige", "label": "Fin du titre (beige)", "default": "sans perdre une heure à le chercher." },
    { "type": "text", "id": "citation", "label": "Citation", "default": "« Une sélection exigeante, testée par Zayado et par des pairs qui l'ont réellement utilisée. »" },
    { "type": "textarea", "id": "texte", "label": "Texte", "default": "Logiciels & IA, cabinets & experts, formations et objets du quotidien : chaque ressource est classée par besoin pour vous faire gagner du temps, sans sacrifier la qualité. La boutique ouvre très bientôt." },
    { "type": "text", "id": "lien_diag", "label": "Lien diagnostic", "default": "/pages/diagnostic" },
    { "type": "text", "id": "atout_1_icone", "label": "Atout 1 : icône", "default": "equipe" },
    { "type": "text", "id": "atout_1_titre", "label": "Atout 1 : titre", "default": "Mise en relation qualifiée" },
    { "type": "textarea", "id": "atout_1_texte", "label": "Atout 1 : texte", "default": "Des profils vérifiés et des besoins ciblés, pour des collaborations qui comptent vraiment." },
    { "type": "text", "id": "atout_2_icone", "label": "Atout 2 : icône", "default": "cle" },
    { "type": "text", "id": "atout_2_titre", "label": "Atout 2 : titre", "default": "Paiements sécurisés" },
    { "type": "textarea", "id": "atout_2_texte", "label": "Atout 2 : texte", "default": "Chaque échange est protégé par Mollie, du premier contact jusqu'à la facture." },
    { "type": "text", "id": "atout_3_icone", "label": "Atout 3 : icône", "default": "graphique" },
    { "type": "text", "id": "atout_3_titre", "label": "Atout 3 : titre", "default": "Assistant IA intégré" },
    { "type": "textarea", "id": "atout_3_texte", "label": "Atout 3 : texte", "default": "Des recommandations personnalisées et des automatisations pour gagner du temps chaque jour." },
    { "type": "text", "id": "lancement", "label": "Pastille lancement", "default": "Lancement très prochainement" },
    { "type": "text", "id": "news_titre", "label": "Liste d'attente : titre", "default": "Soyez parmi les premiers sur la marketplace" },
    { "type": "textarea", "id": "news_texte", "label": "Liste d'attente : texte", "default": "Inscrivez-vous : accès prioritaire dès l'ouverture, un mois d'essai du copilote à 1 €, et tout de suite un guide offert." }
  ],
  "presets": [{ "name": "Zayado — Bientôt (boutique)" }]
}
{% endschema %}
