{%- comment -%}
  Une entrée du Journal, dessinée selon sa rubrique (balise) : article, temoignage ou note.
  {% render 'zayado-carte-journal', article: a %}
{%- endcomment -%}
{%- assign mots = article.content | strip_html | split: ' ' | size -%}
{%- assign minutes = mots | divided_by: 200 | at_least: 1 -%}
{%- if article.tags contains 'temoignage' -%}
  <a class="zy-cj zy-cj--temoignage" href="{{ article.url }}">
    <span class="zy-cj__guillemet" aria-hidden="true">«</span>
    <p class="zy-cj__citation">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
    <span class="zy-cj__personne">{{ article.metafields.zayado.personne.value | default: article.title }}</span>
    <span class="zy-cj__rubrique">Témoignage</span>
  </a>
{%- elsif article.tags contains 'note' -%}
  <a class="zy-cj zy-cj--note" href="{{ article.url }}">
    <span class="zy-cj__date-main">{% render 'zayado-date', d: article.published_at %}</span>
    <h3 class="zy-cj__titre">{{ article.title }}</h3>
    <p class="zy-cj__extrait">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
    <span class="zy-cj__signature">
      {%- if article.user.image -%}{{ article.user.image | image_url: width: 80 | image_tag: class: 'zy-cj__avatar', alt: '' }}{%- else -%}<span class="zy-cj__avatar zy-cj__avatar--vide">{{ article.author | slice: 0 }}</span>{%- endif -%}
      <span>{{ article.author }}<small>Note de la maison</small></span>
    </span>
  </a>
{%- else -%}
  <a class="zy-cj zy-cj--article" href="{{ article.url }}">
    {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: class: 'zy-cj__img', loading: 'lazy', alt: article.title }}{%- endif -%}
    <div class="zy-cj__corps">
      <span class="zy-cj__meta">Article · {% render 'zayado-date', d: article.published_at %} · {{ minutes }} min</span>
      <h3 class="zy-cj__titre">{{ article.title }}</h3>
      <p class="zy-cj__extrait">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
      <span class="zy-cj__lire">Lire l'article →</span>
    </div>
  </a>
{%- endif -%}
