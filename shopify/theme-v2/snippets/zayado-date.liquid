{%- comment -%} Date en français (Shopify écrit les mois en anglais) : {% render 'zayado-date', d: article.published_at, annee: true %} {%- endcomment -%}
{%- assign mois = 'janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre' | split: ',' -%}
{%- assign m = d | date: '%m' | plus: 0 | minus: 1 -%}
{{- d | date: '%-d' }} {{ mois[m] }}{% if annee %} {{ d | date: '%Y' }}{% endif -%}
